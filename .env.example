# =======================================================
# SICE-CBA - Configuración de Conexión con Supabase
# U.E.P. Colegio Bellas Artes
# =======================================================
#
# Para conectar la base de datos de SICE-CBA con Supabase:
# 1. Crea un proyecto gratuito en https://supabase.com
# 2. Ve a Project Settings > API
# 3. Copia la URL del proyecto y la clave pública (anon public key)
# 4. Pega los valores en el archivo .env (no compartas tus claves de servicio)

VITE_SUPABASE_URL=https://tu-proyecto-cba.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica-aqui
